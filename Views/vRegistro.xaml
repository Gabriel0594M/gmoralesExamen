<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="gmoralesExamen.Views.vRegistro"
             Title="Registro">

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="10">

            <Label x:Name="lblUsuario"
                   Style="{StaticResource GlobalUsuario}"
                   Text="Usuario conectado: " />

            <Label
                Text="REGISTRO"
                TextColor="Blue"
                FontSize="22"
                HorizontalOptions="Center" />

            <!--Grid 2 filas x 3 columnas-->
            <Grid RowSpacing="10" ColumnSpacing="10">

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Label Text="Nombre" Grid.Row="0" Grid.Column="0"/>
                <Label Text="Apellido" Grid.Row="0" Grid.Column="1"/>
                <Label Text="Edad" Grid.Row="0" Grid.Column="2"/>

                <Entry x:Name="txtNombre"
                       Style="{StaticResource GlobalEntry}"
                       Placeholder="Ingresar Nombre"
                       Grid.Row="1"
                       Grid.Column="0"/>

                <Entry x:Name="txtApellido"
                       Style="{StaticResource GlobalEntry}"
                       Placeholder="Ingresar Apellido"
                       Grid.Row="1"
                       Grid.Column="1"/>

                <Entry x:Name="txtEdad"
                       Style="{StaticResource GlobalEntry}"
                       Placeholder="Ingresar Edad"
                       Keyboard="Numeric"
                       MaxLength="2"
                       TextChanged="txtEdad_TextChanged"
                       Unfocused="txtEdad_Unfocused"
                       Grid.Row="1"
                       Grid.Column="2"/>

            </Grid>

            <!--Grid 5 filas x 2 columnas-->
            <Grid RowSpacing="10" ColumnSpacing="10">

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Label Text="Fecha de inicio"
                       VerticalOptions="Center"
                       Grid.Row="0"
                       Grid.Column="0"/>

                <DatePicker x:Name="dpFechaInicio"
                            Format="dd/MM/yyyy"
                            Grid.Row="0"
                            Grid.Column="1"/>

                <Label Text="Plan"
                       VerticalOptions="Center"
                       Grid.Row="1"
                       Grid.Column="0"/>

                <Picker x:Name="pkPlan"
                        Title="Seleccione el plan"
                        Grid.Row="1"
                        Grid.Column="1">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Musculación</x:String>
                            <x:String>Cardio</x:String>
                            <x:String>Crossfit</x:String>
                            <x:String>Full</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>

                <Label Text="Casillero"
                       VerticalOptions="Center"
                       Grid.Row="2"
                       Grid.Column="0"/>

                <Switch x:Name="swCasillero"
                        HorizontalOptions="Start"
                        Grid.Row="2"
                        Grid.Column="1"/>

                <Label Text="Monto Inicial"
                       VerticalOptions="Center"
                       Grid.Row="3"
                       Grid.Column="0"/>

                <Entry x:Name="txtMontoInicial"
                       Style="{StaticResource GlobalEntry}"
                       Placeholder="Entre 120 y 600"
                       Keyboard="Numeric"
                       MaxLength="6"
                       TextChanged="txtMontoInicial_TextChanged"
                       Unfocused="txtMontoInicial_Unfocused"
                       Grid.Row="3"
                       Grid.Column="1"/>

                <Button x:Name="btnCalcular"
                        Style="{StaticResource GlobalBotones}"
                        Text="Calcular Pago mensual"
                        Clicked="btnCalcular_Clicked"
                        Grid.Row="4"
                        Grid.Column="0"/>

                <Entry x:Name="txtPagoMensual"
                       Style="{StaticResource GlobalEntry}"
                       Placeholder="Pago mensual"
                       IsReadOnly="True"
                       Grid.Row="4"
                       Grid.Column="1"/>

            </Grid>

            <Button x:Name="btnVerResumen"
                    Style="{StaticResource GlobalBotones}"
                    Text="Ver Resumen"
                    Clicked="btnVerResumen_Clicked"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
